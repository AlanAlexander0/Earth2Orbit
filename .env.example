# Planetary Analog Explorer - Environment Configuration Template
# Copy this file to .env and configure your keys if applicable

# NASA API Key (Optional: NASA POWER and PDS APIs are publicly accessible without a key,
# but a NASA Open API key can be used for elevated rate limits from api.nasa.gov)
NASA_API_KEY=DEMO_KEY

# Application Settings
APP_ENV=production
APP_PORT=8501
DEBUG=False
